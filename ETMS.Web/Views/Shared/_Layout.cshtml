@using System.Security.Claims
@using ETMS.Application.Interfaces
@inject IEmployeeRepository EmployeeRepo
@inject ITransferRequestRepository TransferRepo
@inject INotificationRepository NotificationRepo
@inject IUserSettingsService SettingsService
@inject IUrlEncryptionService UrlEnc

@{
    var themeClass = "theme-light";

    if (User.Identity?.IsAuthenticated == true)
    {
        var themeUserIdClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(themeUserIdClaim, out var themeUserId))
        {
            var settings = await SettingsService.GetSettingsAsync(themeUserId);
            themeClass = settings.Theme switch
            {
                "Dark" => "theme-dark",
                "System" => "theme-system",
                _ => "theme-light"
            };
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ETMS.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ETMS.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Home.css" />
    <link rel="stylesheet" href="~/css/content-scroll.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chatbot.css" />
    <style>
        .dropdown-toggle-no-caret::after {
            display: none !important;
        }

        body {
            background-color: #f4f7fa;
        }

        body.theme-dark {
            background-color: #0f172a;
            color: #dbe4f0;
        }

        body.theme-dark .navbar,
        body.theme-dark .dropdown-menu {
            background-color: #111827 !important;
            border-color: #263244 !important;
        }

        body.theme-dark .navbar-brand,
        body.theme-dark .link-dark,
        body.theme-dark .dropdown-item,
        body.theme-dark .dropdown-header,
        body.theme-dark .fw-bold,
        body.theme-dark .text-dark {
            color: #e5edf7 !important;
        }

        body.theme-dark .text-muted {
            color: #94a3b8 !important;
        }

        body.theme-dark .dropdown-divider,
        body.theme-dark .border-bottom {
            border-color: #263244 !important;
        }

        body.theme-dark .dropdown-item:hover {
            background-color: #1e293b;
        }

        /* Recent changes */

        body.theme-dark .card,
        body.theme-dark .bg-white,
        body.theme-dark .bg-light,
        body.theme-dark .filter-input,
        body.theme-dark .table-card {
            background-color: #1e293b !important;
            border-color: #334155 !important;
            color: #dbe4f0 !important;
        }

        body.theme-dark .metric-card[style*="e8f5e9"],
        body.theme-dark .metric-card[style*="fff8e1"],
        body.theme-dark .metric-card[style*="ffebee"] {
            background-color: #1e293b !important;
        }

        body.theme-dark .text-dark,
        body.theme-dark .fw-bold.text-dark,
        body.theme-dark h4.text-dark,
        body.theme-dark h3.text-dark,
        body.theme-dark td.text-dark,
        body.theme-dark td.fw-bold,
        body.theme-dark [style*="color: #333"],
        body.theme-dark [style*="color:#333"] {
            color: #e2e8f0 !important;
        }

        body.theme-dark .table {
            color: #dbe4f0;
        }
        body.theme-dark .table thead th {
            background-color: #1e293b !important;
            color: #94a3b8 !important;
            border-color: #334155 !important;
        }
        body.theme-dark .table tbody tr {
            border-color: #334155 !important;
        }
        body.theme-dark .table-hover tbody tr:hover {
            background-color: #263244 !important;
        }

        body.theme-dark .form-control,
        body.theme-dark .form-select,
        body.theme-dark .input-group-text {
            background-color: #263244 !important;
            color: #dbe4f0 !important;
            border-color: #334155 !important;
        }
        body.theme-dark .form-control::placeholder {
            color: #64748b !important;
        }
        body.theme-dark .form-select option {
            background-color: #1e293b;
        }

        body.theme-dark .btn-light,
        body.theme-dark .btn-light.border {
            background-color: #263244 !important;
            color: #dbe4f0 !important;
            border-color: #334155 !important;
        }
        body.theme-dark .nav-link.text-muted {
            color: #64748b !important;
        }
        body.theme-dark .active-tab {
            color: #e2e8f0 !important;
            border-bottom-color: #e2e8f0 !important;
        }

        body.theme-dark {
            --card: #1e293b;
            --bg: #0f172a;
            --text: #e2e8f0;
            --muted: #94a3b8;
            --border: #334155;
            --accent-soft: #1e3a5f; 
            --teal-soft: #0f2e2b;
        }

        /* Table rows */
        body.theme-dark .table > tbody > tr {
            background-color: #1e293b !important;
            color: #dbe4f0 !important;
        }

        body.theme-dark .table > tbody > tr:hover {
            background-color: #263244 !important;
        }

        /* The card wrapper around the table */
        body.theme-dark .card.border-0 {
            background-color: #1e293b !important;
        }

        /* The card-body padding wrapper */
        body.theme-dark .card-body {
            background-color: #1e293b !important;
        }

        /* Transfer ID accent color (blue text on accent-soft bg) */
        body.theme-dark .table tbody td a,
        body.theme-dark .table tbody td span.fw-bold {
            color: #93c5fd !important;
        }

        /* Bottom border between rows */
        body.theme-dark .table > tbody > tr > td {
            border-color: #334155 !important;
        }

        /* Kill Bootstrap's table CSS variable overrides */
        body.theme-dark .table {
            --bs-table-bg: #1e293b;
            --bs-table-striped-bg: #263244;
            --bs-table-hover-bg: #263244;
            --bs-table-border-color: #334155;
            --bs-table-color: #dbe4f0;
        }

        /* Force the table-responsive wrapper too */
        body.theme-dark .table-responsive {
            background-color: #1e293b;
        }

        @@media (prefers-color-scheme: dark) {
            body.theme-system {
                background-color: #0f172a;
                color: #dbe4f0;
            }

            body.theme-system .navbar,
            body.theme-system .dropdown-menu {
                background-color: #111827 !important;
                border-color: #263244 !important;
            }

            body.theme-system .navbar-brand,
            body.theme-system .link-dark,
            body.theme-system .dropdown-item,
            body.theme-system .dropdown-header,
            body.theme-system .fw-bold,
            body.theme-system .text-dark {
                color: #e5edf7 !important;
            }

            body.theme-system .text-muted {
                color: #94a3b8 !important;
            }

            body.theme-system .dropdown-divider,
            body.theme-system .border-bottom {
                border-color: #263244 !important;
            }

            body.theme-system .dropdown-item:hover {
                background-color: #1e293b;
            }

            body.theme-dark .table > tbody > tr {
                background-color: #1e293b !important;
                color: #dbe4f0 !important;
            }
        }
    </style>
</head>

<body class="@themeClass">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Dashboard" asp-action="Index" style="color: #333;">Employee Transfer</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <div class="d-flex align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var empIdClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

                            if (int.TryParse(empIdClaim, out int empId))
                            {
                                var currentEmp = await EmployeeRepo.GetEmployeeByIdAsync(empId);
                                var allMyRequests = await TransferRepo.GetByEmployeeIdAsync(empId);
                                var recentRequests = allMyRequests.Take(3).ToList();
                                var notifCount = recentRequests.Count;
                                var unreadCount = await NotificationRepo.GetUnreadCountAsync(empId);
                                var notifications = await NotificationRepo.GetUnreadAsync(empId);

                                if (currentEmp != null)
                                {
                                    <!-- Notification Bell Dropdown -->
                                    <div class="dropdown me-4 mt-1">
                                        <a href="#" class="d-flex align-items-center link-dark text-decoration-none dropdown-toggle-no-caret position-relative"
                                               id="dropdownNotifications" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="far fa-bell" style="font-size: 1.3rem; color: #555;"></i>
                                            @if (unreadCount > 0)
                                            {
                                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                                      style="font-size: 0.6rem; margin-top: 2px;">
                                                    @unreadCount
                                                </span>
                                            }
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0"
                                            aria-labelledby="dropdownNotifications"
                                            style="width: 340px; border-radius: 8px;">
                                            <li>
                                                <div class="d-flex justify-content-between align-items-center px-3 py-2">
                                                    <h6 class="fw-bold text-dark mb-0" style="font-size:14px;">Notifications</h6>
                                                    @if (unreadCount > 0)
                                                    {
                                                        <a href="/Notification/MarkRead" class="small text-primary text-decoration-none">
                                                            Mark all read
                                                        </a>
                                                    }
                                                </div>
                                            </li>
                                            <li><hr class="dropdown-divider m-0"></li>
                                            @if (!notifications.Any())
                                            {
                                                <li>
                                                    <span class="dropdown-item-text text-muted small text-center d-block py-3">
                                                        <i class="far fa-bell-slash d-block mb-1" style="font-size:1.2rem;"></i>
                                                        No notifications
                                                    </span>
                                                </li>
                                            }
                                            else
                                            {
                                                foreach (var notif in notifications)
                                                {
                                                    string iconClass = notif.Title.Contains("Approved") ? "fa-check" :
                                                                       notif.Title.Contains("Rejected") ? "fa-times" : "fa-info";
                                                    string bgClass = notif.Title.Contains("Approved") ? "bg-success" :
                                                                       notif.Title.Contains("Rejected") ? "bg-danger" : "bg-primary";
                                                    string rowBg = notif.IsRead ? "" : "background:#f0f4ff;";

                                                    <li>
                                                        <a class="dropdown-item py-2 px-3"
                                                               href="@(notif.TransferRequestId.HasValue ? $"/Transfer/View/{UrlEnc.Encrypt(notif.TransferRequestId.Value)}" : "/portal")"
                                                               style="@rowBg">
                                                            <div class="d-flex align-items-start gap-2">
                                                                <div class="@bgClass text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 mt-1"
                                                                     style="width:32px;height:32px;">
                                                                    <i class="fas @iconClass" style="font-size:12px;"></i>
                                                                </div>
                                                                <div>
                                                                    <p class="mb-0 fw-bold" style="font-size:12px;color:#333;">@notif.Title</p>
                                                                    <p class="mb-0 text-muted" style="font-size:11px;white-space:normal;">@notif.Message</p>
                                                                    <p class="mb-0 text-muted" style="font-size:10px;">@notif.CreatedAt.ToString("dd MMM, HH:mm")</p>
                                                                </div>
                                                            </div>
                                                        </a>
                                                    </li>
                                                }
                                            }
                                        </ul>
                                    </div>

                                    <!-- Employee Name + Employment Type -->
                                    <div class="text-end me-3 d-none d-sm-block">
                                        <div class="fw-bold" style="font-size: 15px; color: #333; line-height: 1.2;">
                                            @currentEmp.FirstName @currentEmp.LastName
                                        </div>
                                        <div class="text-muted" style="font-size: 13px;">
                                            @currentEmp.EmploymentType
                                        </div>
                                    </div>

                                    <!-- Avatar + User Dropdown -->
                                    <div class="dropdown">
                                        <a href="#" class="d-flex align-items-center link-dark text-decoration-none"
                                           id="navbarDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                            <div class="bg-info text-white rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                                 style="width: 35px; height: 35px; font-size: 0.9rem;">
                                                @currentEmp.FirstName.Substring(0, 1)
                                            </div>
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm mt-2" aria-labelledby="navbarDropdown">
                                            <li>
                                                <h6 class="dropdown-header">
                                                    @currentEmp.EmployeeCode <br />
                                                    <span class="fw-normal">Mumbai Branch</span>
                                                </h6>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>

                                            <!-- ✅ Fixed My Profile link -->
                                            <li>
                                                <a class="dropdown-item" asp-controller="Profile" asp-action="MyProfile">
                                                    <i class="fas fa-user-circle me-2"></i> My Profile
                                                </a>
                                            </li>

                                            <!-- ✅ Fixed Settings link -->
                                            <li>
                                                <a class="dropdown-item" asp-controller="Profile" asp-action="Settings">
                                                    <i class="fas fa-cog me-2"></i> Settings
                                                </a>
                                            </li>

                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <a class="dropdown-item text-danger" href="/Account/Logout">
                                                    <i class="fas fa-sign-out-alt me-2"></i> Logout
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid" style="max-width: 1400px; min-height: 100vh; padding-bottom: 100px;">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <!-- ── ETMS Chatbot ── -->
    <div id="chat-bubble" onclick="toggleChat()">
        <span>💬</span>
        <div class="chat-unread" id="chat-unread">1</div>
    </div>

    <div id="chat-window">
        <div id="chat-header">
            <div class="chat-header-left">
                <div class="chat-avatar">🤖</div>
                <div>
                    <div class="chat-bot-name">ETMS Assistant</div>
                    <div class="chat-status">
                        <div class="chat-dot"></div>
                        <span>Online · Always here to help</span>
                    </div>
                </div>
            </div>
            <button id="chat-close-btn" onclick="toggleChat()">✕</button>
        </div>

        <div id="chat-messages">
            <div class="msg bot">
                👋 Hi! I'm your <b>ETMS Assistant</b>.<br>
                Ask me anything about transfers, profile, or the system!
            </div>
        </div>

        <div id="chat-input-area">
            <input type="text" id="chat-input" placeholder="Ask me anything..." />
            <button id="chat-send-btn" onclick="chatHandleSend()">➤</button>
        </div>
    </div>

    <script src="~/js/chatbot.js"></script>
</body>
</html>
