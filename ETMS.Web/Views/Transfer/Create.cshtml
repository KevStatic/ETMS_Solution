@model ETMS.Web.Models.CreateTransferViewModel
@{
    ViewData["Title"] = "Employee Mobility Request";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --accent: #4F7EFF;
        --teal:   #38C9C0;
        --text:   #1A1D2E;
        --muted:  #8B90A7;
        --border: #E4E8F0;
        --bg:     #F4F6FB;
        --card:   #FFFFFF;
    }
    body { background: var(--bg); font-family: 'DM Sans', sans-serif; }

    .profile-card  { background: var(--card); border-radius: 14px; border: 1px solid var(--border); overflow: hidden; }
    .profile-top   { background: linear-gradient(135deg, #4F7EFF 0%, #38C9C0 100%); padding: 24px; color: #fff; }
    .avatar-circle  { width: 52px; height: 52px; border-radius: 50%; background: rgba(255,255,255,.25);
                      display:flex; align-items:center; justify-content:center; font-size:1.3rem; }
    .profile-body  { padding: 20px; }
    .info-row      { margin-bottom: 12px; }
    .info-lbl      { font-size: 10px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 600; margin-bottom: 1px; }
    .info-val      { font-size: 13px; font-weight: 600; color: var(--text); }
    .divider       { border-top: 1px solid var(--border); margin: 16px 0; }
    .person-row    { display:flex; align-items:center; gap:10px; margin-bottom:12px; }
    .person-av     { width:32px; height:32px; border-radius:50%; background:var(--bg);
                     display:flex; align-items:center; justify-content:center; color:var(--muted); font-size:.8rem; flex-shrink:0; }

    .section-card  { background:var(--card); border-radius:14px; border:1px solid var(--border); margin-bottom:20px; overflow:hidden; }
    .section-head  { padding:16px 24px; border-bottom:1px solid var(--border); font-weight:700; font-size:.95rem; color:var(--text); display:flex; align-items:center; gap:8px; }
    .section-body  { padding:24px; }

    .loc-box       { border-radius:10px; padding:18px; height:100%; }
    .loc-from      { background:#F4F6FB; border:1px solid var(--border); }
    .loc-to        { background:#EEF2FF; border:2px solid #4F7EFF; }
    .loc-label     { font-size:11px; text-transform:uppercase; letter-spacing:.06em; font-weight:700; margin-bottom:12px; display:flex; align-items:center; gap:6px; }
    .arrow-circle  { width:42px; height:42px; border-radius:50%; background:var(--accent); color:#fff;
                     display:flex; align-items:center; justify-content:center; font-size:1rem; }

    .form-label    { font-size:11px; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); font-weight:600; margin-bottom:4px; }
    .form-control, .form-select { border-radius:8px; border:1px solid var(--border); font-size:13px; padding:9px 12px; background:#fff; }
    .form-control:focus, .form-select:focus { border-color:var(--accent); box-shadow:0 0 0 3px rgba(79,126,255,.12); }
    .disabled-field { background:#F4F6FB !important; color:var(--muted); }
    .radio-group   { display:flex; gap:16px; padding-top:4px; }
    .radio-group .form-check-label { font-size:13px; font-weight:500; }

    .btn-cancel  { background:#fff; border:1px solid var(--border); border-radius:10px; padding:10px 24px; font-size:13px; font-weight:600; color:var(--muted); text-decoration:none; }
    .btn-submit  { background:linear-gradient(135deg,#4F7EFF,#38C9C0); border:none; border-radius:10px; padding:10px 28px; font-size:13px; font-weight:700; color:#fff; transition: opacity .15s, transform .1s; }
    .btn-submit:hover { opacity:.9; transform:translateY(-1px); color:#fff; }

    .field-validation-error { font-size:11px; color:#EF4444; margin-top:3px; display:block; }
    .input-validation-error { border-color:#EF4444 !important; }
    .assist-note { border-radius: 12px; padding: 12px 14px; font-size: 12px; border: 1px solid transparent; }
    .assist-note.info { background:#eef2ff; color:#3153a4; border-color:#d8e1ff; }
    .assist-note.success { background:#ecfdf5; color:#0f766e; border-color:#c8f5df; }
    .assist-note.hidden { display:none; }
    .suggestion-meta { font-size: 11px; color: var(--muted); margin-top: 2px; }
    .suggestion-count { background:#eef2ff; color:var(--accent); border-radius:999px; padding:2px 8px; font-size:11px; font-weight:700; }

    /* Dark mode: the card surfaces inherit dark via the layout's CSS variables;
       these override the few hardcoded light hex values used above. */
    body.theme-dark .loc-from { background:#273347; border-color:#3a4860; }
    body.theme-dark .loc-to { background:#1c3252; border-color:#3b62a8; }
    body.theme-dark .btn-cancel { background:#1e293b; border-color:#3a4860; color:#cbd5e1; }
    body.theme-dark .disabled-field { background:#1f2a3b !important; color:#94a3b8; }
    body.theme-dark .assist-note.info { background:#1c3252; color:#bfdbfe; border-color:#3b62a8; }
    body.theme-dark .assist-note.success { background:#13311f; color:#bbf7d0; border-color:#2f7d4f; }
    body.theme-dark .suggestion-count { background:#1c3252; color:#93c5fd; }

    @@media (prefers-color-scheme: dark) {
        body.theme-system .loc-from { background:#273347; border-color:#3a4860; }
        body.theme-system .loc-to { background:#1c3252; border-color:#3b62a8; }
        body.theme-system .btn-cancel { background:#1e293b; border-color:#3a4860; color:#cbd5e1; }
        body.theme-system .disabled-field { background:#1f2a3b !important; color:#94a3b8; }
        body.theme-system .assist-note.info { background:#1c3252; color:#bfdbfe; border-color:#3b62a8; }
        body.theme-system .assist-note.success { background:#13311f; color:#bbf7d0; border-color:#2f7d4f; }
        body.theme-system .suggestion-count { background:#1c3252; color:#93c5fd; }
    }
</style>

<div class="container-fluid mt-4 mb-5" style="max-width:1360px;">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0" style="color:var(--text);">
                <i class="fas fa-plane-departure me-2" style="color:var(--accent);"></i> @Model.RequesterRoleLabel Mobility Request
            </h3>
            <p class="text-muted small mb-0 mt-1">Fill in the details below and submit for approval.</p>
        </div>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-cancel d-flex align-items-center gap-2">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    @if (Model.PrefilledFromRequestId.HasValue)
    {
        <div class="alert border-0 shadow-sm mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2"
             style="background:#eef2ff;border-radius:12px;">
            <div class="small text-dark fw-medium">
                <i class="fas fa-copy text-primary me-2"></i>
                This form was prefilled from request <strong>TR-@Model.PrefilledFromRequestId.Value.ToString("D5")</strong>. Review the details before resubmitting.
            </div>
            <a asp-action="Create" class="btn btn-light btn-sm rounded-pill px-3">Start Fresh</a>
        </div>
    }

    <div class="row g-4">

        <!-- LEFT: Profile Panel -->
        <div class="col-lg-3">
            <div class="profile-card sticky-top" style="top:20px;">
                <div class="profile-top">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="avatar-circle"><i class="fas fa-user"></i></div>
                        <div>
                            <div class="fw-bold" style="font-size:.95rem;">@Model.EmployeeName</div>
                            <div style="font-size:.8rem;opacity:.8;">@Model.EmployeeCode</div>
                        </div>
                    </div>
                    <div style="font-size:.78rem;opacity:.75;">Current Employee Details</div>
                </div>
                <div class="profile-body">
                    <div class="row g-0">
                        <div class="col-6 info-row pe-2">
                            <div class="info-lbl"><i class="fas fa-tag me-1"></i>Grade</div>
                            <div class="info-val">@Model.Grade</div>
                        </div>
                        <div class="col-6 info-row ps-2">
                            <div class="info-lbl"><i class="fas fa-sitemap me-1"></i>SBU</div>
                            <div class="info-val">@Model.SBU</div>
                        </div>
                        <div class="col-12 info-row">
                            <div class="info-lbl"><i class="fas fa-building me-1"></i>Department</div>
                            <div class="info-val">@Model.CurrentDepartment</div>
                        </div>
                        <div class="col-12 info-row">
                            <div class="info-lbl"><i class="fas fa-rupee-sign me-1"></i>Cost Center</div>
                            <div class="info-val">@Model.CostCenter</div>
                        </div>
                        <div class="col-12 info-row">
                            <div class="info-lbl"><i class="fas fa-map-marker-alt me-1"></i>Location</div>
                            <div class="info-val">@Model.CurrentLocation</div>
                        </div>
                        <div class="col-12 info-row">
                            <div class="info-lbl"><i class="fas fa-briefcase me-1"></i>Company</div>
                            <div class="info-val">@Model.Company</div>
                        </div>
                    </div>
                    <div class="divider"></div>
                    <div class="person-row">
                        <div class="person-av"><i class="fas fa-user-tie"></i></div>
                        <div>
                            <div class="info-lbl">Immediate Supervisor</div>
                            <div class="info-val" style="font-size:12px;">@Model.ISName</div>
                            <div class="text-muted" style="font-size:11px;">@Model.ISCode</div>
                        </div>
                    </div>
                    <div class="person-row">
                        <div class="person-av"><i class="fas fa-user-tie"></i></div>
                        <div>
                            <div class="info-lbl">Department Head</div>
                            <div class="info-val" style="font-size:12px;">@Model.DHName</div>
                            <div class="text-muted" style="font-size:11px;">@Model.DHCode</div>
                        </div>
                    </div>
                    <div class="person-row">
                        <div class="person-av"><i class="fas fa-user-shield"></i></div>
                        <div>
                            <div class="info-lbl">HRBP</div>
                            <div class="info-val" style="font-size:12px;">@Model.HRBPName</div>
                            <div class="text-muted" style="font-size:11px;">HR Central</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: Form -->
        <div class="col-lg-9">
            <form asp-action="Create" method="post">
                <div class="section-card">
                    <div class="section-head">
                        <i class="fas fa-lightbulb" style="color:var(--accent);"></i> Smart Assist
                    </div>
                    <div class="section-body">
                        <div id="draftStatusBanner" class="assist-note info hidden mb-3"></div>

                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                            <div>
                                <div class="fw-bold text-dark mb-1">Drafts are auto-saved in this browser</div>
                                <div class="text-muted small">If you close the page midway, you can restore your latest draft when you come back. Prefilled requests can also be quickly adjusted and resubmitted here.</div>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" id="restoreDraftBtn" class="btn btn-light border rounded-pill px-3">Restore Draft</button>
                                <button type="button" id="clearDraftBtn" class="btn btn-light border rounded-pill px-3">Clear Draft</button>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <span class="badge bg-light text-dark border rounded-pill px-3 py-2">Live vacancy suggestions</span>
                            <span class="badge bg-light text-dark border rounded-pill px-3 py-2">Browser draft recovery</span>
                            @if (Model.PrefilledFromRequestId.HasValue)
                            {
                                <span class="badge text-primary border border-primary rounded-pill px-3 py-2">Resubmission mode</span>
                            }
                        </div>

                        @if (Model.SuggestedOpenPositions.Any())
                        {
                            <div class="mt-4">
                                <div class="fw-bold text-dark mb-2">Popular Openings</div>
                                <div class="text-muted small mb-3">Based on currently open transfer positions. Clicking a suggestion will prefill the target location and department for you.</div>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var position in Model.SuggestedOpenPositions.Take(8))
                                    {
                                        <button type="button"
                                                class="btn btn-light border rounded-pill px-3 py-2 vacancy-suggestion"
                                                data-location="@position.LocationName"
                                                data-department="@position.DepartmentName">
                                            <i class="fas fa-location-dot text-primary me-1"></i>@position.LocationName
                                            <span class="text-muted ms-1">• @position.DepartmentName</span>
                                            <span class="suggestion-count ms-2">@position.OpenSlotCount open</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- 1. Transfer Location -->
                <div class="section-card">
                    <div class="section-head">
                        <i class="fas fa-exchange-alt" style="color:var(--accent);"></i> Transfer Location
                    </div>
                    <div class="section-body">
                        <div class="row g-3 align-items-stretch">
                            <div class="col-md-5">
                                <div class="loc-box loc-from h-100">
                                    <div class="loc-label" style="color:var(--muted);">
                                        <i class="fas fa-map-marker-alt"></i> From (Current)
                                    </div>
                                    <input class="form-control form-control-sm disabled-field mb-2" disabled value="@Model.FromType" />
                                    <input class="form-control form-control-sm disabled-field" disabled value="@Model.CurrentLocation, @Model.CurrentCountry" />
                                </div>
                            </div>
                            <div class="col-md-2 d-flex align-items-center justify-content-center">
                                <div class="arrow-circle"><i class="fas fa-arrow-right"></i></div>
                            </div>
                            <div class="col-md-5">
                                <div class="loc-box loc-to h-100">
                                    <div class="loc-label" style="color:var(--accent);">
                                        <i class="fas fa-dot-circle"></i> To (Target)
                                    </div>
                                    <select asp-for="ToType" class="form-select form-select-sm mb-2" id="toTypeDropdown">
                                        <option value="">Select Type</option>
                                        <option value="Domestic">Domestic</option>
                                        <option value="International">International</option>
                                    </select>
                                    <span asp-validation-for="ToType" class="field-validation-error"></span>
                                    <select asp-for="ToLocationId" class="form-select form-select-sm" id="toLocationDropdown">
                                        <option value="">Select Location</option>
                                        @if (Model.RawLocations != null)
                                        {
                                            foreach (var loc in Model.RawLocations)
                                            {
                                                var locType = loc.Country == "India" ? "Domestic" : "International";
                                                <option value="@loc.LocationId" data-type="@locType">@loc.City, @loc.Country</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="ToLocationId" class="field-validation-error"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Transfer Details -->
                <div class="section-card">
                    <div class="section-head">
                        <i class="fas fa-clipboard-list" style="color:var(--accent);"></i> Transfer Details
                    </div>
                    <div class="section-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Transfer Type <span class="text-danger">*</span></label>
                                <select asp-for="TransferType" class="form-select">
                                    <option value="">Select</option>
                                    <option value="Permanent">Permanent Transfer</option>
                                    <option value="Temporary">Temporary Transfer</option>
                                    <option value="Deputation">Deputation</option>
                                    <option value="ProjectAssignment">Project Assignment</option>
                                    <option value="DepartmentChange">Department Change</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Within City</label>
                                <div class="radio-group">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="WithinCity" value="Yes" id="cityYes">
                                        <label class="form-check-label" for="cityYes">Yes</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="WithinCity" value="No" id="cityNo">
                                        <label class="form-check-label" for="cityNo">No</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Relocation Status</label>
                                <div class="radio-group">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="RelocationStatus" value="Bachelor" id="bachelor">
                                        <label class="form-check-label" for="bachelor">Bachelor</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="RelocationStatus" value="Family" id="family">
                                        <label class="form-check-label" for="family">Family</label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Start Date <span class="text-danger">*</span></label>
                                <input asp-for="StartDate" type="date" class="form-control" />
                                <span asp-validation-for="StartDate" class="field-validation-error"></span>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">End Date</label>
                                <input asp-for="EndDate" type="date" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Expected Relieving Date <span class="text-danger">*</span></label>
                                <input asp-for="ExpectedRelievingDate" type="date" class="form-control" />
                                <span asp-validation-for="ExpectedRelievingDate" class="field-validation-error"></span>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Expected Joining Date <span class="text-danger">*</span></label>
                                <input asp-for="ExpectedJoiningDate" type="date" class="form-control" />
                                <span asp-validation-for="ExpectedJoiningDate" class="field-validation-error"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. New Posting Details -->
                <div class="section-card">
                    <div class="section-head">
                        <i class="fas fa-building" style="color:var(--accent);"></i> New Posting Details
                    </div>
                    <div class="section-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Project Name <span class="text-danger">*</span></label>
                                <input asp-for="ProjectName" type="text" class="form-control" placeholder="Enter project name" />
                                <span asp-validation-for="ProjectName" class="field-validation-error"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">New Vertical <span class="text-danger">*</span></label>
                                <select asp-for="NewVertical" class="form-select">
                                    <option value="">Select Vertical</option>
                                    <option value="IT Operations">IT Operations</option>
                                    <option value="Civil Infrastructure">Civil Infrastructure</option>
                                </select>
                                <span asp-validation-for="NewVertical" class="field-validation-error"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">New Department <span class="text-danger">*</span></label>
                                <select asp-for="ToDepartmentId" asp-items="Model.Departments" class="form-select">
                                    <option value="">Select Department</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">New BU <span class="text-danger">*</span></label>
                                <select asp-for="NewBU" class="form-select">
                                    <option value="">Select BU</option>
                                    <option value="Corporate">Corporate</option>
                                    <option value="Metro Projects">Metro Projects</option>
                                </select>
                                <span asp-validation-for="NewBU" class="field-validation-error"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">IC Head <span class="text-danger">*</span></label>
                                <select asp-for="ICHead" class="form-select">
                                    <option value="">Select</option>
                                    <option value="S. N. Subrahmanyan">S. N. Subrahmanyan</option>
                                    <option value="R. Shankar Raman">R. Shankar Raman</option>
                                </select>
                                <span asp-validation-for="ICHead" class="field-validation-error"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 4. New IS Details -->
                <div class="section-card">
                    <div class="section-head">
                        <i class="fas fa-user-tie" style="color:var(--accent);"></i> New Immediate Supervisor Details
                    </div>
                    <div class="section-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">PSNO</label>
                                <input asp-for="NewISPsno" type="text" class="form-control" placeholder="Employee PSNO" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Name</label>
                                <input asp-for="NewISName" type="text" class="form-control" placeholder="Full name" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Email</label>
                                <input asp-for="NewISEmail" type="email" class="form-control" placeholder="Work email" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 5. Relocation & Reimbursement -->
                <div class="section-card">
                    <div class="section-head">
                        <i class="fas fa-suitcase-rolling" style="color:var(--accent);"></i> Relocation &amp; Reimbursement
                    </div>
                    <div class="section-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Travel Mode</label>
                                <select asp-for="TravelMode" class="form-select" id="travelModeSelect">
                                    <option value="">Select Mode</option>
                                    <option value="Air">Air</option>
                                    <option value="Train">Train</option>
                                    <option value="Road / Personal Vehicle">Road / Personal Vehicle</option>
                                    <option value="Company Transport">Company Transport</option>
                                </select>
                            </div>
                            <div class="col-md-4" id="travelClassCol" style="display:none;">
                                <label class="form-label">Class of Travel</label>
                                <select asp-for="TravelClass" class="form-select" id="travelClassSelect">
                                    <option value="">Select Class</option>
                                    <option value="Economy" class="air-train">Economy</option>
                                    <option value="Business" class="air-only">Business</option>
                                    <option value="AC 1st Class" class="train-only">AC 1st Class</option>
                                    <option value="AC 2-Tier" class="train-only">AC 2-Tier</option>
                                    <option value="AC 3-Tier" class="train-only">AC 3-Tier</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Relocation Allowance Requested</label>
                                <div class="radio-group">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="RelocationAllowance" value="Yes" id="relAllowYes">
                                        <label class="form-check-label" for="relAllowYes">Yes</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="RelocationAllowance" value="No" id="relAllowNo">
                                        <label class="form-check-label" for="relAllowNo">No</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Accommodation at New Location</label>
                                <select asp-for="AccommodationRequired" class="form-select">
                                    <option value="Not Required">Not Required</option>
                                    <option value="Company Guest House">Company Guest House</option>
                                    <option value="Leased Accommodation">Leased Accommodation</option>
                                    <option value="Self-Arranged">Self-Arranged</option>
                                </select>
                            </div>
                            <div class="col-md-4" id="dependentsCol" style="display:none;">
                                <label class="form-label">No. of Dependents Relocating</label>
                                <select asp-for="DependentsCount" class="form-select">
                                    <option value="">Select</option>
                                    <option value="0">0</option>
                                    <option value="1">1</option>
                                    <option value="2">2</option>
                                    <option value="3">3</option>
                                    <option value="4">4+</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 6. Handover & Transition -->
                <div class="section-card">
                    <div class="section-head">
                        <i class="fas fa-tasks" style="color:var(--accent);"></i> Handover &amp; Transition
                    </div>
                    <div class="section-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Notice Period</label>
                                <select asp-for="NoticePeriodWeeks" class="form-select">
                                    <option value="">Select</option>
                                    <option value="2">2 Weeks</option>
                                    <option value="4">4 Weeks</option>
                                    <option value="6">6 Weeks</option>
                                    <option value="8">8 Weeks</option>
                                    <option value="12">12 Weeks</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Knowledge Transfer Required</label>
                                <div class="radio-group">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="KnowledgeTransferReqd" value="Yes" id="ktYes">
                                        <label class="form-check-label" for="ktYes">Yes</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="KnowledgeTransferReqd" value="No" id="ktNo">
                                        <label class="form-check-label" for="ktNo">No</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Current Project / Task Status</label>
                                <textarea asp-for="CurrentTaskStatus" class="form-control" rows="2"
                                          placeholder="Briefly describe the current state of your projects and tasks…"></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Handover Plan</label>
                                <textarea asp-for="HandoverPlan" class="form-control" rows="3"
                                          placeholder="Outline how responsibilities will be handed over — who takes over, timeline, documentation…"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 7. Remarks -->
                <div class="section-card">
                    <div class="section-head">
                        <i class="fas fa-comment-alt" style="color:var(--accent);"></i> Remarks
                    </div>
                    <div class="section-body">
                        <textarea asp-for="Remarks" class="form-control" rows="3"
                                  placeholder="Add any additional context or reason for this transfer request…"></textarea>
                        <span asp-validation-for="Remarks" class="field-validation-error"></span>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-3 mt-2">
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-cancel">Cancel</a>
                    <button type="submit" class="btn btn-submit">
                        <i class="fas fa-paper-plane me-2"></i> Send For Approval
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.querySelector('form');
        var typeSelect = document.getElementById('toTypeDropdown');
        var locSelect  = document.getElementById('toLocationDropdown');
        var allOptions = Array.from(locSelect.options).filter(o => o.value !== "");
        const deptSelect = document.querySelector('[name="ToDepartmentId"]');
        const employeeCode = '@Model.EmployeeCode';
        const draftKey = 'etms-transfer-draft-' + employeeCode;
        const draftStatusBanner = document.getElementById('draftStatusBanner');
        const isPrefilledRequest = @(Model.PrefilledFromRequestId.HasValue ? "true" : "false");

        function showBanner(message, type) {
            if (!draftStatusBanner) return;
            draftStatusBanner.textContent = message;
            draftStatusBanner.classList.remove('hidden', 'info', 'success');
            draftStatusBanner.classList.add(type);
        }

        function hideBanner() {
            if (!draftStatusBanner) return;
            draftStatusBanner.classList.add('hidden');
        }

        typeSelect.addEventListener('change', function () {
            var selected = this.value;
            locSelect.innerHTML = '<option value="">Select Location</option>';
            if (selected) {
                allOptions.forEach(opt => {
                    if (opt.getAttribute('data-type') === selected)
                        locSelect.appendChild(opt.cloneNode(true));
                });
            }
        });

        typeSelect.dispatchEvent(new Event('change'));

        document.querySelectorAll('.vacancy-suggestion').forEach(btn => {
            btn.addEventListener('click', function () {
                const locationLabel = this.dataset.location;
                const departmentLabel = this.dataset.department;

                const locationOption = Array.from(allOptions).find(opt => opt.text.startsWith(locationLabel.split(',')[0]));
                if (locationOption) {
                    typeSelect.value = locationOption.getAttribute('data-type') || '';
                    typeSelect.dispatchEvent(new Event('change'));
                    const selectedOption = Array.from(locSelect.options).find(opt => opt.value === locationOption.value);
                    if (selectedOption) {
                        locSelect.value = selectedOption.value;
                    }
                }

                const deptOption = Array.from(deptSelect.options).find(opt => opt.text === departmentLabel);
                if (deptOption) {
                    deptSelect.value = deptOption.value;
                }

                showBanner(`Suggestion applied for ${locationLabel} - ${departmentLabel}. Review the rest of the request before submitting.`, 'success');
            });
        });

        function collectDraft() {
            const data = {};
            form.querySelectorAll('input, select, textarea').forEach(field => {
                if (!field.name || field.disabled) return;
                if ((field.type === 'radio' || field.type === 'checkbox') && !field.checked) return;
                data[field.name] = field.value;
            });
            localStorage.setItem(draftKey, JSON.stringify(data));
            if (!isPrefilledRequest) {
                showBanner('Draft saved in this browser. You can safely return later and restore it.', 'info');
            }
        }

        function restoreDraft() {
            const raw = localStorage.getItem(draftKey);
            if (!raw) return false;

            const data = JSON.parse(raw);
            Object.entries(data).forEach(([name, value]) => {
                const fields = form.querySelectorAll(`[name="${name}"]`);
                fields.forEach(field => {
                    if (field.type === 'radio' || field.type === 'checkbox') {
                        field.checked = field.value === value;
                    } else {
                        field.value = value;
                    }
                });
            });

            typeSelect.dispatchEvent(new Event('change'));
            if (data.ToLocationId) {
                locSelect.value = data.ToLocationId;
            }
            showBanner('Saved draft restored. Double-check the dates and target posting before submitting.', 'success');
            return true;
        }

        document.getElementById('restoreDraftBtn')?.addEventListener('click', function () {
            if (!restoreDraft()) {
                showBanner('No saved draft was found for this form yet.', 'info');
            }
        });

        document.getElementById('clearDraftBtn')?.addEventListener('click', function () {
            localStorage.removeItem(draftKey);
            showBanner('Saved draft cleared for this request form.', 'info');
        });

        form.querySelectorAll('input, select, textarea').forEach(field => {
            field.addEventListener('change', collectDraft);
            field.addEventListener('input', collectDraft);
        });

        form.addEventListener('submit', function () {
            localStorage.removeItem(draftKey);
            hideBanner();
        });

        // Travel mode → show/hide class of travel with relevant options
        const travelModeSelect = document.getElementById('travelModeSelect');
        const travelClassCol   = document.getElementById('travelClassCol');
        const travelClassSelect = document.getElementById('travelClassSelect');

        function updateTravelClass() {
            const mode = travelModeSelect.value;
            const isAir   = mode === 'Air';
            const isTrain = mode === 'Train';
            travelClassCol.style.display = (isAir || isTrain) ? '' : 'none';
            Array.from(travelClassSelect.options).forEach(opt => {
                if (opt.value === '') return;
                const forAir   = opt.classList.contains('air-only');
                const forTrain = opt.classList.contains('train-only');
                const both     = opt.classList.contains('air-train');
                opt.hidden = forAir   ? !isAir
                           : forTrain ? !isTrain
                           : both     ? !(isAir || isTrain)
                           : false;
            });
            if (travelClassSelect.selectedOptions[0]?.hidden) travelClassSelect.value = '';
        }
        travelModeSelect.addEventListener('change', updateTravelClass);
        updateTravelClass();

        // Relocation status → show dependents count only for Family moves
        const relocationRadios  = document.querySelectorAll('[name="RelocationStatus"]');
        const dependentsCol     = document.getElementById('dependentsCol');

        function updateDependents() {
            const isFamily = document.querySelector('[name="RelocationStatus"]:checked')?.value === 'Family';
            dependentsCol.style.display = isFamily ? '' : 'none';
        }
        relocationRadios.forEach(r => r.addEventListener('change', updateDependents));
        updateDependents();

        if (localStorage.getItem(draftKey)) {
            showBanner('A saved draft is available for this request form. Use Restore Draft to continue from where you left off.', 'info');
        }
    });
</script>
