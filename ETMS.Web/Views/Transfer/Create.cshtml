@model ETMS.Web.Models.CreateTransferViewModel

@{
    ViewData["Title"] = "New Transfer Request";
}

<div class="container-fluid mt-4" style="max-width: 1400px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: #333;">Initiate Transfer Request</h2>
            <p class="text-muted">Complete the form below to formally request a location or department change.</p>
        </div>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i> Back to Dashboard
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 sticky-top" style="border-radius: 12px; top: 20px;">
                <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                    <h5 class="fw-bold mb-0 text-dark">Current Information</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-info text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-4 me-3" style="width: 60px; height: 60px;">
                            @(string.IsNullOrEmpty(Model.EmployeeName) ? "E" : Model.EmployeeName.Substring(0, 1))
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">@Model.EmployeeName</h5>
                            <span class="text-muted small">@Model.EmployeeCode</span>
                        </div>
                    </div>

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-start border-light">
                            <div class="ms-2 me-auto">
                                <div class="fw-bold text-dark small text-uppercase">Department</div>
                                <span class="text-muted">@Model.CurrentDepartment</span>
                            </div>
                        </li>
                        <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-start border-light">
                            <div class="ms-2 me-auto">
                                <div class="fw-bold text-dark small text-uppercase">Location</div>
                                <span class="text-muted">@Model.CurrentLocation</span>
                            </div>
                        </li>
                        <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-start border-light">
                            <div class="ms-2 me-auto">
                                <div class="fw-bold text-dark small text-uppercase">Reporting Manager</div>
                                <span class="text-muted">@Model.ReportingManager</span>
                            </div>
                        </li>
                        <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-start border-light">
                            <div class="ms-2 me-auto">
                                <div class="fw-bold text-dark small text-uppercase">Employment Type</div>
                                <span class="text-muted">@Model.EmploymentType</span>
                            </div>
                        </li>
                        <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-start border-light">
                            <div class="ms-2 me-auto">
                                <div class="fw-bold text-dark small text-uppercase">Date of Joining</div>
                                <span class="text-muted">@Model.DateOfJoining.ToString("dd MMM, yyyy")</span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <form asp-action="Create" method="post" enctype="multipart/form-data">

                <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                    <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                        <h5 class="fw-bold mb-0 text-dark">Transfer Request Details</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label asp-for="TransferType" class="form-label fw-bold text-muted small text-uppercase">Type of Transfer <span class="text-danger">*</span></label>
                                <select asp-for="TransferType" class="form-select bg-light border-0 py-2">
                                    <option value="">-- Select Type --</option>
                                    <option value="Permanent Transfer">Permanent Transfer</option>
                                    <option value="Temporary Transfer">Temporary Transfer</option>
                                    <option value="Deputation">Deputation / Assignment</option>
                                    <option value="Cross-department">Cross-department Transfer</option>
                                    <option value="Project-based">Project-based Transfer</option>
                                </select>
                                <span asp-validation-for="TransferType" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ReasonCategory" class="form-label fw-bold text-muted small text-uppercase">Reason Category <span class="text-danger">*</span></label>
                                <select asp-for="ReasonCategory" class="form-select bg-light border-0 py-2">
                                    <option value="">-- Select Category --</option>
                                    <option value="Employee Initiated">Employee Initiated</option>
                                    <option value="Business Requirement">Business Requirement</option>
                                    <option value="Manager Recommendation">Manager Recommendation</option>
                                    <option value="Medical Reason">Medical Reason</option>
                                    <option value="Personal Relocation">Personal Relocation</option>
                                    <option value="Project Re-allocation">Project Re-allocation</option>
                                    <option value="Internal Promotion Move">Internal Promotion Move</option>
                                </select>
                                <span asp-validation-for="ReasonCategory" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="ToLocationId" class="form-label fw-bold text-muted small text-uppercase">Target Location <span class="text-danger">*</span></label>
                                <select asp-for="ToLocationId" asp-items="Model.Locations" class="form-select bg-light border-0 py-2">
                                    <option value="">-- Select Location --</option>
                                </select>
                                <span asp-validation-for="ToLocationId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ToDepartmentId" class="form-label fw-bold text-muted small text-uppercase">Target Department <span class="text-danger">*</span></label>
                                <select asp-for="ToDepartmentId" asp-items="Model.Departments" class="form-select bg-light border-0 py-2">
                                    <option value="">-- Select Department --</option>
                                </select>
                                <span asp-validation-for="ToDepartmentId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-4 mt-1 mb-4">
                            <div class="col-md-12">
                                <label asp-for="NewManagerName" class="form-label fw-bold text-muted small text-uppercase">Proposed New Manager (Optional)</label>
                                <input asp-for="NewManagerName" type="text" class="form-control bg-light border-0 py-2" placeholder="Enter manager's name if known" />
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="EffectiveDate" class="form-label fw-bold text-muted small text-uppercase">Proposed Effective Date <span class="text-danger">*</span></label>
                                <input asp-for="EffectiveDate" type="date" class="form-control bg-light border-0 py-2" />
                                <span asp-validation-for="EffectiveDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Priority" class="form-label fw-bold text-muted small text-uppercase">Transfer Priority <span class="text-danger">*</span></label>
                                <select asp-for="Priority" class="form-select bg-light border-0 py-2">
                                    <option value="Normal">Normal</option>
                                    <option value="Urgent">Urgent</option>
                                    <option value="Immediate">Immediate</option>
                                </select>
                                <span asp-validation-for="Priority" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                    <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                        <h5 class="fw-bold mb-0 text-dark">Justification & Handover</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-4">
                            <label asp-for="Reason" class="form-label fw-bold text-muted small text-uppercase">Detailed Reason for Transfer <span class="text-danger">*</span></label>
                            <textarea asp-for="Reason" class="form-control bg-light border-0" rows="4" placeholder="Provide background context, personal/professional reasons, and justification..."></textarea>
                            <span asp-validation-for="Reason" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="HandoverPlan" class="form-label fw-bold text-muted small text-uppercase">Handover Plan (Optional)</label>
                            <textarea asp-for="HandoverPlan" class="form-control bg-light border-0" rows="3" placeholder="Specify tasks to complete, expected replacement, ongoing projects..."></textarea>
                        </div>

                        <div class="mb-2">
                            <label asp-for="SupportingDocument" class="form-label fw-bold text-muted small text-uppercase">Supporting Documents (Optional)</label>
                            <input asp-for="SupportingDocument" type="file" class="form-control bg-light border-0 py-2" accept=".pdf,.jpg,.png,.docx" />
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                    <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                        <h5 class="fw-bold mb-0 text-dark">Contact Information</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-bold text-muted small text-uppercase">Current Phone Number</label>
                                <input asp-for="Phone" type="tel" class="form-control bg-light border-0 py-2" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PersonalEmail" class="form-label fw-bold text-muted small text-uppercase">Personal Email</label>
                                <input asp-for="PersonalEmail" type="email" class="form-control bg-light border-0 py-2" />
                                <span asp-validation-for="PersonalEmail" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0 mb-4 bg-light" style="border-radius: 12px;">
                    <div class="card-body p-4">
                        <h6 class="fw-bold mb-3 text-dark">Compliance & Declarations</h6>

                        <div class="form-check mb-2">
                            <input asp-for="HasNoDisciplinaryCase" class="form-check-input" type="checkbox">
                            <label class="form-check-label small text-muted">
                                I confirm there are no ongoing disciplinary cases against me.
                            </label>
                            <span asp-validation-for="HasNoDisciplinaryCase" class="text-danger small d-block"></span>
                        </div>

                        <div class="form-check mb-2">
                            <input asp-for="MinimumTenureCompleted" class="form-check-input" type="checkbox">
                            <label class="form-check-label small text-muted">
                                I confirm I have completed the minimum tenure required in my current role.
                            </label>
                            <span asp-validation-for="MinimumTenureCompleted" class="text-danger small d-block"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="DeclarationConfirmed" class="form-check-input" type="checkbox">
                            <label class="form-check-label small text-muted">
                                I confirm the details provided are accurate and I understand that approval is subject to HR review.
                            </label>
                            <span asp-validation-for="DeclarationConfirmed" class="text-danger small d-block"></span>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn text-white fw-bold px-5 py-2" style="background-color: #66D2CE; border-radius: 6px;">
                                Submit Request
                            </button>
                        </div>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}