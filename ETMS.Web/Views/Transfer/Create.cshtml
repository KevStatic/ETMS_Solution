@model ETMS.Web.Models.CreateTransferViewModel

@{
    ViewData["Title"] = "New Transfer Request";
}

<div class="container mt-5" style="max-width: 800px;">
    <div class="card shadow-sm border-0" style="border-radius: 12px;">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
            <h3 class="fw-bold" style="color: #333;">Submit Transfer Request</h3>
            <p class="text-muted">Please fill in the details for your relocation request.</p>
        </div>

        <div class="card-body p-4">
            <form asp-action="Create" method="post">

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="ToLocationId" class="form-label fw-bold">Target Location</label>
                        <select asp-for="ToLocationId" asp-items="Model.Locations" class="form-select bg-light border-0 py-2">
                            <option value="">-- Select Destination --</option>
                        </select>
                        <span asp-validation-for="ToLocationId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ToDepartmentId" class="form-label fw-bold">Target Department</label>
                        <select asp-for="ToDepartmentId" asp-items="Model.Departments" class="form-select bg-light border-0 py-2">
                            <option value="">-- Select Department --</option>
                        </select>
                        <span asp-validation-for="ToDepartmentId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="TransferType" class="form-label fw-bold">Transfer Type</label>
                    <select asp-for="TransferType" class="form-select bg-light border-0 py-2">
                        <option value="">-- Select Type --</option>
                        <option value="Permanent">Permanent Relocation</option>
                        <option value="Temporary">Temporary Deputation</option>
                    </select>
                    <span asp-validation-for="TransferType" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Reason" class="form-label fw-bold">Reason for Transfer</label>
                    <textarea asp-for="Reason" class="form-control bg-light border-0" rows="4" placeholder="Briefly explain why you are requesting this transfer..."></textarea>
                    <span asp-validation-for="Reason" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-3">
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-light fw-bold px-4 py-2 text-muted border">Cancel</a>
                    <button type="submit" class="btn text-white fw-bold px-4 py-2" style="background-color: #66D2CE;">Submit Request</button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}