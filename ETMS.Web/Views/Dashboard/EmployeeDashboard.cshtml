@model ETMS.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Employee Dashboard";
}

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --accent: #4F7EFF;
        --accent-soft: #EEF2FF;
        --teal: #38C9C0;
        --teal-soft: #E8FAF9;
        --text: #1A1D2E;
        --muted: #8B90A7;
        --border: #E4E8F0;
        --bg: #F4F6FB;
        --card: #FFFFFF;
        --success: #22C55E;
        --warning: #F59E0B;
        --danger: #EF4444;
    }

    body {
        font-family: 'DM Sans', sans-serif;
        background: var(--bg);
        color: var(--text);
    }

    .welcome-strip {
        background: linear-gradient(120deg, #4F7EFF 0%, #38C9C0 100%);
        border-radius: 14px;
        padding: 28px 36px;
        color: #fff;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
    }

        .welcome-strip::before {
            content: '';
            position: absolute;
            right: -40px;
            top: -40px;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255,255,255,0.08);
        }

        .welcome-strip::after {
            content: '';
            position: absolute;
            right: 60px;
            bottom: -60px;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: rgba(255,255,255,0.06);
        }

    .welcome-title {
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .welcome-sub {
        font-size: 14px;
        opacity: 0.85;
    }

    .info-pills {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        position: relative;
        z-index: 1;
    }

    .info-pill {
        background: rgba(255,255,255,0.18);
        backdrop-filter: blur(6px);
        border: 1px solid rgba(255,255,255,0.25);
        border-radius: 50px;
        padding: 6px 14px;
        font-size: 12px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 6px;
        color: #fff;
    }

    .stat-card {
        background: var(--card);
        border-radius: 14px;
        padding: 20px 22px;
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: 0 2px 12px rgba(79,126,255,0.06);
    }

    .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

        .stat-icon.blue {
            background: var(--accent-soft);
            color: var(--accent);
        }

        .stat-icon.teal {
            background: var(--teal-soft);
            color: var(--teal);
        }

        .stat-icon.green {
            background: #F0FDF4;
            color: var(--success);
        }

        .stat-icon.amber {
            background: #FFFBEB;
            color: var(--warning);
        }

    .stat-value {
        font-size: 26px;
        font-weight: 700;
        font-family: 'DM Mono', monospace;
        line-height: 1;
        margin-bottom: 2px;
    }

    .stat-label {
        font-size: 12px;
        color: var(--muted);
        font-weight: 500;
    }

    .table-card {
        background: var(--card);
        border-radius: 14px;
        border: 1px solid var(--border);
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(79,126,255,0.06);
    }

    .table-card-header {
        padding: 24px 28px 0;
    }

    .table-title {
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 16px;
    }

    .tab-group {
        background: var(--bg);
        border-radius: 10px;
        padding: 4px;
        display: inline-flex;
        gap: 4px;
    }

    .tab-btn {
        padding: 7px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        color: var(--muted);
        transition: all 0.15s;
    }

        .tab-btn.active {
            background: var(--card);
            color: var(--text);
            box-shadow: 0 1px 6px rgba(0,0,0,0.08);
        }

    .search-wrap {
        display: flex;
        align-items: center;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 0 14px;
        gap: 8px;
        width: 240px;
    }

        .search-wrap i {
            color: var(--muted);
            font-size: 13px;
        }

        .search-wrap input {
            border: none;
            background: transparent;
            font-size: 13px;
            font-family: 'DM Sans', sans-serif;
            color: var(--text);
            padding: 9px 0;
            width: 100%;
            outline: none;
        }

    .btn-new {
        background: var(--accent);
        color: #fff !important;
        border: none;
        border-radius: 10px;
        padding: 9px 18px;
        font-size: 13px;
        font-weight: 600;
        font-family: 'DM Sans', sans-serif;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: opacity 0.15s, transform 0.1s;
    }

        .btn-new:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    .requests-table {
        width: 100%;
        border-collapse: collapse;
    }

        .requests-table thead th {
            padding: 13px 16px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--muted);
            text-align: left;
            background: var(--bg);
            border-bottom: 1px solid var(--border);
        }

            .requests-table thead th:first-child {
                padding-left: 28px;
            }

            .requests-table thead th:last-child {
                text-align: right;
                padding-right: 28px;
            }

        .requests-table tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background 0.12s;
        }

            .requests-table tbody tr:last-child {
                border-bottom: none;
            }

            .requests-table tbody tr:hover {
                background: var(--bg);
            }

        .requests-table tbody td {
            padding: 16px;
            font-size: 14px;
            vertical-align: middle;
        }

            .requests-table tbody td:first-child {
                padding-left: 28px;
            }

            .requests-table tbody td:last-child {
                text-align: right;
                padding-right: 24px;
            }

    .tr-id {
        font-family: 'DM Mono', monospace;
        font-size: 13px;
        font-weight: 500;
        color: var(--accent);
        background: var(--accent-soft);
        padding: 4px 10px;
        border-radius: 6px;
        display: inline-block;
    }

    .target-dept {
        font-weight: 600;
        color: var(--text);
        font-size: 13px;
    }

    .target-loc {
        font-size: 12px;
        color: var(--muted);
        margin-top: 2px;
    }

    .date-cell {
        color: var(--muted);
        font-size: 13px;
    }

    .sort-link {
        color: var(--muted);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        transition: color 0.15s;
    }

        .sort-link:hover {
            color: var(--text);
        }

    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600;
    }

        .badge-status::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            flex-shrink: 0;
        }

    .badge-approved {
        background: #F0FDF4;
        color: #16A34A;
    }

        .badge-approved::before {
            background: var(--success);
        }

    .badge-pending {
        background: #FFFBEB;
        color: #B45309;
    }

        .badge-pending::before {
            background: var(--warning);
        }

    .badge-rejected {
        background: #FFF1F2;
        color: #BE123C;
    }

        .badge-rejected::before {
            background: var(--danger);
        }

    .badge-cancelled {
        background: #F8FAFC;
        color: var(--muted);
    }

        .badge-cancelled::before {
            background: var(--muted);
        }

    .btn-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--card);
        color: var(--muted);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.15s;
        text-decoration: none;
    }

        .btn-icon:hover {
            background: var(--bg);
            color: var(--text);
            border-color: var(--text);
        }

        .btn-icon.danger:hover {
            background: #FFF1F2;
            color: var(--danger);
            border-color: var(--danger);
        }

    .empty-state {
        text-align: center;
        padding: 64px 20px;
        color: var(--muted);
    }

        .empty-state i {
            font-size: 36px;
            opacity: 0.3;
            margin-bottom: 12px;
            display: block;
        }

        .empty-state p {
            font-size: 14px;
        }
</style>

<style>
    body {
        background-color: #f8fafc;
    }

    .metric-card {
        border-radius: 12px;
        transition: transform 0.2s;
        border: none;
    }

        .metric-card:hover {
            transform: translateY(-3px);
        }

    .icon-box {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .filter-input {
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        font-size: 0.9rem;
        color: #495057;
    }

    .active-tab {
        color: #333 !important;
        border-bottom: 3px solid #333 !important;
        background: transparent !important;
    }
</style>

<div class="container-fluid mt-4 mb-5 pb-5" style="max-width: 1400px;">

    @if (TempData["SuccessMessage"] != null)
    {
        <div id="toastSuccess" class="alert alert-success shadow-sm border-0 position-fixed"
             style="top: 20px; right: 20px; z-index: 9999; border-radius: 8px; transition: opacity 0.5s ease-in-out;">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        </div>

        <script>
            setTimeout(function() {
                var alert = document.getElementById('toastSuccess');
                if (alert) {
                    alert.style.opacity = '0';
                    setTimeout(() => alert.remove(), 500);
                }
            }, 3000);
        </script>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark d-flex align-items-center mb-1">
                <i class="fas fa-mountain text-primary me-2"></i> Welcome to your mobility portal
            </h3>
            <p class="text-muted mb-0">Manage your transfer requests and approvals.</p>
        </div>
        <div class="text-end">
            <div class="bg-white px-3 py-2 border shadow-sm text-muted" style="border-radius: 8px; font-size: 0.85rem; font-weight: 500;">
                <i class="fas fa-building me-2"></i> @Model.UserLocationName | @Model.UserDepartmentName
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-2 col-sm-6">
            <div class="card metric-card shadow-sm h-100 p-3" style="background-color: #e8f5e9;">
                <div class="d-flex align-items-center mb-2">
                    <div class="icon-box bg-success text-white me-2"><i class="fas fa-check-circle"></i></div>
                    <div class="fw-bold text-dark" style="font-size: 0.95rem;">Active Requests</div>
                </div>
                <h2 class="fw-bold mb-0 text-success ms-1">@Model.Metrics.ActiveRequests</h2>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card metric-card shadow-sm h-100 p-3" style="background-color: #fff8e1;">
                <div class="d-flex align-items-center mb-2">
                    <div class="icon-box bg-warning text-white me-2"><i class="fas fa-hourglass-half"></i></div>
                    <div class="fw-bold text-dark" style="font-size: 0.95rem;">Pending Approvals</div>
                </div>
                <h2 class="fw-bold mb-0 text-warning ms-1">@Model.Metrics.PendingApprovals</h2>
            </div>
        </div>
        <div class="col-md-2 col-sm-6">
            <div class="card metric-card shadow-sm h-100 p-3" style="background-color: #ffebee;">
                <div class="d-flex align-items-center mb-2">
                    <div class="icon-box bg-danger text-white me-2"><i class="fas fa-times-circle"></i></div>
                    <div class="fw-bold text-dark" style="font-size: 0.95rem;">Rejected</div>
                </div>
                <h2 class="fw-bold mb-0 text-danger ms-1">@Model.Metrics.Rejected</h2>
            </div>
        </div>
        <div class="col-md-2 col-sm-6">
            <div class="card metric-card shadow-sm h-100 p-3 bg-white">
                <div class="d-flex align-items-center mb-2">
                    <div class="icon-box bg-primary text-white me-2"><i class="fas fa-clock"></i></div>
                    <div class="fw-bold text-dark" style="font-size: 0.95rem;">Avg Approval Time</div>
                </div>
                <h2 class="fw-bold mb-0 text-dark ms-1">@Model.Metrics.AvgApprovalDays <span style="font-size: 1rem;" class="text-muted fw-normal">days</span></h2>
            </div>
        </div>
        <div class="col-md-3 col-sm-12">
            <div class="card metric-card shadow-sm h-100 p-3 bg-white" style="border: 1px solid #e9ecef;">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex align-items-center">
                        <div class="icon-box bg-info text-white me-2" style="background-color: #5c9bba !important; border-radius: 8px;"><i class="fas fa-bullseye"></i></div>
                        <div class="fw-bold text-dark" style="font-size: 1rem;">Open Positions</div>
                    </div>
                    <h2 class="fw-normal mb-0 text-muted" style="font-size: 2rem; line-height: 1;">@Model.Metrics.TotalOpenPositions</h2>
                </div>

                <ul class="list-unstyled mb-0 mt-2 ms-1">
                    @foreach (var pos in Model.Metrics.OpenPositionsByLocation)
                    {
                        <li class="d-flex align-items-center mb-1 text-muted" style="font-size: 0.8rem;">
                            <i class="fas fa-circle me-2" style="font-size: 0.35rem; color: #6c757d;"></i>
                            <span class="flex-grow-1">@pos.Key:</span>
                            <span>@pos.Value pos.</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 12px;">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0 text-dark">My Transfer Requests</h4>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 border-bottom pb-3">
                <ul class="nav nav-pills border-0 mb-2 mb-md-0">
                    <li class="nav-item">
                        <a class="nav-link fw-bold @(ViewBag.CurrentFilter == "Active" ? "active-tab" : "text-muted")"
                           href="@Url.Action("Index", new { filterType = "Active" })">
                            Active
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-bold @(ViewBag.CurrentFilter == "All" ? "active-tab" : "text-muted")"
                           href="@Url.Action("Index", new { filterType = "All" })">
                            All Requests
                        </a>
                    </li>
                </ul>

                <div class="d-flex gap-2 align-items-center">
                    <form asp-action="Index" method="get" class="d-flex gap-2 mb-0">
                        <input type="hidden" name="filterType" value="@ViewBag.CurrentFilter" />

                        <div class="input-group" style="width: 250px;">
                            <span class="input-group-text bg-light border-end-0 filter-input"><i class="fas fa-search text-muted"></i></span>
                            <input type="text" name="searchTerm" value="@ViewBag.CurrentSearch" class="form-control bg-light border-start-0 filter-input" placeholder="Search ID or Status...">
                        </div>

                        <select class="form-select filter-input" style="width: 170px;" asp-items="Model.Locations">
                            <option value="">Filter by Location</option>
                        </select>
                        <select class="form-select filter-input" style="width: 190px;" asp-items="Model.Departments">
                            <option value="">Filter by Dept</option>
                        </select>
                    </form>

                    <a asp-controller="Transfer" asp-action="Create" class="btn text-white fw-bold px-4 py-2 text-nowrap" style="background-color: #66D2CE; border-radius: 8px;">
                        + New Transfer Request
                    </a>
                </div>
            </div>
        </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-white text-muted text-uppercase small" style="border-bottom: 2px solid #e9ecef;">
                        <tr>
                            <th class="py-3 ps-3 border-0 fw-bold">TransferId</th>
                            <th class="py-3 border-0 fw-bold">Target Posting</th>
                            <th class="py-3 border-0 fw-bold">
                                <a href="@Url.Action("Index", new { sortOrder = ViewBag.DateSort, filterType = ViewBag.CurrentFilter, searchTerm = ViewBag.CurrentSearch })" class="text-decoration-none text-muted">
                                    Date <i class="fas fa-sort ms-1"></i>
                                </a>
                            </th>
                            <th class="py-3 border-0 fw-bold">
                                <a href="@Url.Action("Index", new { sortOrder = ViewBag.StatusSort, filterType = ViewBag.CurrentFilter, searchTerm = ViewBag.CurrentSearch })" class="text-decoration-none text-muted">
                                    Status <i class="fas fa-sort ms-1"></i>
                                </a>
                            </th>
                            <th class="py-3 text-end pe-4 border-0 fw-bold">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Requests.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="fas fa-inbox fa-2x mb-3 d-block opacity-25"></i>
                                    No transfer requests found matching your criteria.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var req in Model.Requests)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-dark py-3">
                                        TR-@req.TransferRequestId.ToString("D5")
                                    </td>
                                    <td>
                                        <span class="d-block fw-bold text-dark">@req.TargetLocation</span>
                                        <span class="text-muted small">@req.TargetDepartment</span>
                                    </td>
                                    <td class="text-dark fw-medium">
                                        @req.RequestDate.ToString("dd MMM, yyyy")
                                    </td>
                                    <td>
                                        @if (req.Status == "Approved")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 rounded-pill">Approved</span>
                                        }
                                        else if (req.Status == "Rejected" || req.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-3 py-2 rounded-pill">@req.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning px-3 py-2 rounded-pill">Pending</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <!-- Eye → links to TransferController.View -->
                                        <a asp-controller="Transfer" asp-action="View" asp-route-id="@req.TransferRequestId"
                                           class="btn btn-light btn-sm mx-1 rounded-circle" title="View details">
                                            <i class="far fa-eye text-secondary"></i>
                                        </a>

                                        <!-- Delete → only for Pending requests -->
                                        @if (req.Status == "Pending")
                                        {
                                            <form asp-controller="Transfer" asp-action="Delete" asp-route-id="@req.TransferRequestId"
                                                  method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-light btn-sm mx-1 rounded-circle"
                                                        title="Delete request"
                                                        onclick="return confirm('Delete this transfer request? This cannot be undone.')">
                                                    <i class="far fa-trash-alt text-danger"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

</div>
