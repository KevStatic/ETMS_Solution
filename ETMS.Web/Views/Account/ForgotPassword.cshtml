@model ETMS.Application.DTOs.SendOtpDto
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ETMS – Forgot Password</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            min-height: 100vh;
            background: #1a2744;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

            body::before {
                content: '';
                position: absolute;
                inset: 0;
                background: url('/images/login-bg.jpg') center/cover no-repeat;
                opacity: 0.35;
            }

        .card {
            background: #fff;
            border-radius: 20px;
            padding: 40px 44px;
            width: 460px;
            max-width: 95vw;
            position: relative;
            z-index: 1;
            box-shadow: 0 24px 64px rgba(0,0,0,.35);
            animation: slideUp .4s cubic-bezier(.22,1,.36,1);
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(24px)
            }

            to {
                opacity: 1;
                transform: none
            }
        }

        .steps {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 28px;
        }

        .step-dot {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #e8eefb;
            color: #6b7a99;
            font-size: .8rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .step-dot.active {
                background: #2a56c6;
                color: #fff;
            }

            .step-dot.done {
                background: #1e8449;
                color: #fff;
            }

        .step-line {
            flex: 1;
            height: 3px;
            background: #e8eefb;
            max-width: 60px;
        }

            .step-line.done {
                background: #1e8449;
            }

        .icon-wrap {
            width: 62px;
            height: 62px;
            background: #e8eefb;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 18px;
        }

            .icon-wrap svg {
                width: 28px;
                height: 28px;
                stroke: #2a56c6;
                fill: none;
                stroke-width: 2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        h2 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1a1a2e;
            text-align: center;
            margin-bottom: 6px;
        }

        .sub {
            color: #6b7a99;
            font-size: .9rem;
            text-align: center;
            margin-bottom: 24px;
            line-height: 1.5;
        }

        .field {
            margin-bottom: 16px;
        }

        label {
            display: block;
            font-size: .875rem;
            font-weight: 500;
            color: #1a1a2e;
            margin-bottom: 6px;
        }

        .inp-wrap {
            display: flex;
            align-items: center;
            border: 1.5px solid #d0d8e8;
            border-radius: 8px;
            background: #f4f7fc;
            overflow: hidden;
            transition: border-color .2s, box-shadow .2s;
        }

            .inp-wrap:focus-within {
                border-color: #2a56c6;
                box-shadow: 0 0 0 3px rgba(42,86,198,.12);
            }

            .inp-wrap svg {
                width: 20px;
                height: 20px;
                stroke: #2a56c6;
                fill: none;
                stroke-width: 2;
                stroke-linecap: round;
                stroke-linejoin: round;
                margin: 0 12px;
                flex-shrink: 0;
            }

            .inp-wrap input {
                flex: 1;
                border: none;
                background: transparent;
                padding: 12px 14px 12px 0;
                font-family: inherit;
                font-size: .95rem;
                color: #1a1a2e;
                outline: none;
            }

                .inp-wrap input::placeholder {
                    color: #aab4cb;
                }

        .field-err {
            color: #d93025;
            font-size: .8rem;
            margin-top: 4px;
        }

        .val-summary {
            background: #fdecea;
            border: 1px solid #f5c6c2;
            border-radius: 8px;
            color: #d93025;
            font-size: .875rem;
            padding: 10px 14px;
            margin-bottom: 14px;
        }

        .btn {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 10px;
            background: #2a56c6;
            color: #fff;
            font-family: inherit;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: background .2s, transform .15s;
            margin-top: 6px;
        }

            .btn:hover {
                background: #1e3f99;
                transform: translateY(-1px);
            }

        .back-link {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            margin-top: 18px;
            color: #6b7a99;
            font-size: .875rem;
            text-decoration: none;
        }

            .back-link:hover {
                color: #2a56c6;
            }
    </style>
</head>
<body>
    <div class="card">
        <div class="steps">
            <div class="step-dot active">1</div>
            <div class="step-line"></div>
            <div class="step-dot">2</div>
            <div class="step-line"></div>
            <div class="step-dot">3</div>
        </div>
        <div class="icon-wrap">
            <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
        </div>
        <h2>Forgot Password?</h2>
        <p class="sub">Enter your registered email to receive an OTP verification code.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="val-summary">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div class="field">
                <label asp-for="Email">Email Address</label>
                <div class="inp-wrap">
                    <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
                    <input asp-for="Email" type="email" placeholder="Enter your registered email" />
                </div>
                <span asp-validation-for="Email" class="field-err"></span>
            </div>
            <button type="submit" class="btn">Send OTP Code</button>
        </form>
        <a asp-action="Login" asp-controller="Account" class="back-link">← Back to Login</a>
    </div>
</body>
</html>
