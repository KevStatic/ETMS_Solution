@model ETMS.Application.DTOs.ResetPasswordDto
@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ETMS – Reset Password</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            min-height: 100vh;
            background: #1a2744;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

            body::before {
                content: '';
                position: absolute;
                inset: 0;
                background: url('/images/login-bg.jpg') center/cover no-repeat;
                opacity: 0.35;
            }

        .card {
            background: #fff;
            border-radius: 20px;
            padding: 40px 44px;
            width: 460px;
            max-width: 95vw;
            position: relative;
            z-index: 1;
            box-shadow: 0 24px 64px rgba(0,0,0,.35);
            animation: slideUp .4s cubic-bezier(.22,1,.36,1);
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(24px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Step indicator */
        .steps {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 28px;
        }

        .step-dot {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #e8eefb;
            color: #6b7a99;
            font-size: .8rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .step-dot.active {
                background: #2a56c6;
                color: #fff;
            }

            .step-dot.done {
                background: #1e8449;
                color: #fff;
            }

        .step-line {
            flex: 1;
            height: 3px;
            background: #e8eefb;
            max-width: 60px;
        }

            .step-line.done {
                background: #1e8449;
            }

        .icon-wrap {
            width: 62px;
            height: 62px;
            background: #e8eefb;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 18px;
        }

            .icon-wrap svg {
                width: 28px;
                height: 28px;
                stroke: #2a56c6;
                fill: none;
                stroke-width: 2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        h2 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1a1a2e;
            text-align: center;
            margin-bottom: 6px;
        }

        .sub {
            color: #6b7a99;
            font-size: .9rem;
            text-align: center;
            margin-bottom: 24px;
        }

        .field {
            margin-bottom: 16px;
        }

        label {
            display: block;
            font-size: .875rem;
            font-weight: 500;
            color: #1a1a2e;
            margin-bottom: 6px;
        }

        .inp-wrap {
            display: flex;
            align-items: center;
            border: 1.5px solid #d0d8e8;
            border-radius: 8px;
            background: #f4f7fc;
            overflow: hidden;
            transition: border-color .2s, box-shadow .2s;
        }

            .inp-wrap:focus-within {
                border-color: #2a56c6;
                box-shadow: 0 0 0 3px rgba(42,86,198,.12);
            }

            .inp-wrap svg {
                width: 20px;
                height: 20px;
                stroke: #2a56c6;
                fill: none;
                stroke-width: 2;
                stroke-linecap: round;
                stroke-linejoin: round;
                margin: 0 12px;
                flex-shrink: 0;
            }

            .inp-wrap input {
                flex: 1;
                border: none;
                background: transparent;
                padding: 12px 0;
                font-family: inherit;
                font-size: .95rem;
                color: #1a1a2e;
                outline: none;
            }

                .inp-wrap input::placeholder {
                    color: #aab4cb;
                }

        .eye-btn {
            background: none;
            border: none;
            cursor: pointer;
            margin-right: 12px;
            color: #6b7a99;
            display: flex;
            align-items: center;
            transition: opacity .2s;
        }

            .eye-btn svg {
                width: 18px;
                height: 18px;
                stroke: currentColor;
                fill: none;
                stroke-width: 2;
                margin: 0; /* override .inp-wrap svg margin */
            }

        .field-err {
            color: #d93025;
            font-size: .8rem;
            margin-top: 4px;
        }

        /* Password strength bar */
        .str-bar {
            display: flex;
            gap: 4px;
            margin: 8px 0 4px;
        }

        .str-seg {
            flex: 1;
            height: 4px;
            border-radius: 99px;
            background: #e0e5f0;
            transition: background .3s;
        }

        .str-label {
            font-size: .8rem;
            color: #6b7a99;
            margin-bottom: 10px;
        }

        /* Requirements chips */
        .req-list {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            margin: 4px 0 16px;
            list-style: none;
        }

            .req-list li {
                font-size: .78rem;
                padding: 3px 9px;
                border-radius: 99px;
                background: #f0f3fb;
                color: #6b7a99;
                transition: all .25s;
            }

                .req-list li::before {
                    content: '✗  ';
                    font-size: .72rem;
                }

                .req-list li.ok {
                    background: #e8f5e9;
                    color: #1e8449;
                }

                    .req-list li.ok::before {
                        content: '✓  ';
                    }

        .val-summary {
            background: #fdecea;
            border: 1px solid #f5c6c2;
            border-radius: 8px;
            color: #d93025;
            font-size: .875rem;
            padding: 10px 14px;
            margin-bottom: 14px;
        }

        .btn {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 10px;
            background: #2a56c6;
            color: #fff;
            font-family: inherit;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: background .2s, transform .15s, box-shadow .2s;
            margin-top: 6px;
            letter-spacing: .02em;
        }

            .btn:hover {
                background: #1e3f99;
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(42,86,198,.3);
            }
    </style>
</head>
<body>
    <div class="card">

        <!-- Step indicator -->
        <div class="steps">
            <div class="step-dot done">✓</div>
            <div class="step-line done"></div>
            <div class="step-dot done">✓</div>
            <div class="step-line done"></div>
            <div class="step-dot active">3</div>
        </div>

        <div class="icon-wrap">
            <svg viewBox="0 0 24 24">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                <polyline points="9 12 11 14 15 10" />
            </svg>
        </div>

        <h2>Create New Password</h2>
        <p class="sub">Identity verified. Set a strong new password below.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="val-summary">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()

            <!-- Hidden reset token -->
            <input type="hidden" asp-for="ResetToken" />

            <!-- New Password -->
            <div class="field">
                <label asp-for="NewPassword">New Password</label>
                <div class="inp-wrap">
                    <svg viewBox="0 0 24 24">
                        <rect x="3" y="11" width="18" height="11" rx="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                    <input asp-for="NewPassword" type="password" id="newPwd"
                           placeholder="Enter new password" oninput="checkStrength()" />
                    <button type="button" class="eye-btn" onclick="togglePw('newPwd', this)" tabindex="-1">
                        <svg viewBox="0 0 24 24">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>

                <!-- Strength bar -->
                <div class="str-bar">
                    <div class="str-seg" id="s1"></div>
                    <div class="str-seg" id="s2"></div>
                    <div class="str-seg" id="s3"></div>
                    <div class="str-seg" id="s4"></div>
                </div>
                <div class="str-label" id="strLabel">Password strength</div>

                <!-- Requirements -->
                <ul class="req-list">
                    <li id="r-len">8+ characters</li>
                    <li id="r-up">Uppercase</li>
                    <li id="r-lo">Lowercase</li>
                    <li id="r-num">Number</li>
                    <li id="r-sym">Symbol</li>
                </ul>

                <span asp-validation-for="NewPassword" class="field-err"></span>
            </div>

            <!-- Confirm Password -->
            <div class="field">
                <label asp-for="ConfirmPassword">Confirm Password</label>
                <div class="inp-wrap">
                    <svg viewBox="0 0 24 24">
                        <rect x="3" y="11" width="18" height="11" rx="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                    <input asp-for="ConfirmPassword" type="password" id="confPwd"
                           placeholder="Confirm your new password" />
                    <button type="button" class="eye-btn" onclick="togglePw('confPwd', this)" tabindex="-1">
                        <svg viewBox="0 0 24 24">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-err"></span>
            </div>

            <button type="submit" class="btn">Reset Password</button>
        </form>

    </div>

    <script>
        // Show / hide password
        function togglePw(id, btn) {
            const inp = document.getElementById(id);
            inp.type = inp.type === 'password' ? 'text' : 'password';
            btn.style.opacity = inp.type === 'text' ? '0.45' : '1';
        }

        // Password strength checker
        function checkStrength() {
            const pw = document.getElementById('newPwd').value;

            const checks = {
                'r-len': pw.length >= 8,
                'r-up':  /[A-Z]/.test(pw),
                'r-lo':  /[a-z]/.test(pw),
                'r-num': /[0-9]/.test(pw),
                'r-sym': /[^A-Za-z0-9]/.test(pw)
            };

            let score = Object.values(checks).filter(Boolean).length;

            // Update requirement chips
            Object.entries(checks).forEach(([id, ok]) => {
                document.getElementById(id).classList.toggle('ok', ok);
            });

            // Update strength bar
            const colors = ['#d93025', '#f5a623', '#2196f3', '#1e8449'];
            const labels = ['', 'Weak', 'Fair', 'Good', 'Strong'];
            ['s1','s2','s3','s4'].forEach((id, i) => {
                document.getElementById(id).style.background =
                    i < score - 1 ? colors[Math.min(score - 1, 3)] : '#e0e5f0';
            });
            document.getElementById('strLabel').textContent = labels[score] || 'Password strength';
        }
    </script>
</body>
</html>
