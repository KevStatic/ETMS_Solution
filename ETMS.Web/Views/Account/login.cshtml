@{
    Layout = null;
}
@using Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - ETMS</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body, html {
            width: 100%;
            height: 100%;
            font-family: 'DM Sans', sans-serif;
            overflow: hidden;
        }

        .page-bg {
            width: 100vw;
            height: 100vh;
            background: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)), url('https://2025prodstorageaccount-eqdyc8g8hpccdfez.a02.azurefd.net/ltprod/media/rlojt5xu/hydrocarbon-offshore.webp') center center / cover no-repeat;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px;
        }

        .card-shell {
            width: 900px;
            height: 560px;
            max-width: 100%;
            background: #fff;
            border-radius: 26px;
            overflow: hidden;
            box-shadow: 0 40px 100px rgba(0,0,0,0.4);
            display: flex;
            flex-direction: row;
            flex-shrink: 0;
        }

        .form-side {
            width: 400px;
            flex-shrink: 0;
            padding: 50px 46px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: #fff;
        }

        .brand-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 34px;
        }

        .brand-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #1a56db;
        }

        .brand-text {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #111;
        }

        h2 {
            font-size: 23px;
            font-weight: 700;
            color: #111;
            margin-bottom: 5px;
            letter-spacing: -0.3px;
        }

        .sub {
            font-size: 13px;
            color: #bbb;
            margin-bottom: 28px;
        }

        .err-box {
            background: #fff3f3;
            border: 1px solid #fca5a5;
            border-radius: 8px;
            padding: 10px 13px;
            margin-bottom: 14px;
            font-size: 12px;
            color: #dc2626;
        }

        .field {
            margin-bottom: 16px;
        }

            .field label {
                display: block;
                font-size: 12px;
                font-weight: 500;
                color: #555;
                margin-bottom: 7px;
            }

        .ibox {
            display: flex;
            align-items: center;
            border: 1.5px solid #e8e8e8;
            border-radius: 9px;
            padding: 11px 13px;
            background: #fafafa;
            transition: all 0.2s;
        }

            .ibox:focus-within {
                border-color: #1a56db;
                background: #fff;
                box-shadow: 0 0 0 3px rgba(26,86,219,0.1);
            }

            .ibox i {
                color: #ccc;
                font-size: 13px;
                margin-right: 10px;
                width: 14px;
                text-align: center;
                transition: color 0.2s;
            }

            .ibox:focus-within i {
                color: #1a56db;
            }

            .ibox input {
                border: none;
                outline: none;
                width: 100%;
                font-size: 14px;
                color: #111;
                background: transparent;
                font-family: 'DM Sans', sans-serif;
            }

                .ibox input::placeholder {
                    color: #ccc;
                }

                /* ✅ Remove browser autofill blue highlight */
                .ibox input:-webkit-autofill,
                .ibox input:-webkit-autofill:hover,
                .ibox input:-webkit-autofill:focus,
                .ibox input:-webkit-autofill:active {
                    -webkit-box-shadow: 0 0 0px 1000px #fafafa inset !important;
                    box-shadow: 0 0 0px 1000px #fafafa inset !important;
                    -webkit-text-fill-color: #111 !important;
                    transition: background-color 5000s ease-in-out 0s;
                }

        .opts {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 8px 0 22px;
        }

        .remember {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 13px;
            color: #666;
            cursor: pointer;
        }

            .remember input {
                accent-color: #1a56db;
                width: 14px;
                height: 14px;
            }

        .fp {
            font-size: 13px;
            color: #1a56db;
            font-weight: 600;
            text-decoration: none;
        }

            .fp:hover {
                text-decoration: underline;
            }

        .btn-login {
            width: 100%;
            padding: 13px;
            background: #1a56db;
            color: #fff;
            border: none;
            border-radius: 9px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            font-family: 'DM Sans', sans-serif;
            transition: background 0.2s, transform 0.15s;
            box-shadow: 0 4px 16px rgba(26,86,219,0.35);
        }

            .btn-login:hover {
                background: #1447b5;
                transform: translateY(-1px);
            }

            .btn-login:active {
                transform: translateY(0);
            }

        .footer-note {
            text-align: center;
            margin-top: 14px;
            font-size: 12.5px;
            color: #bbb;
        }

            .footer-note a {
                color: #1a56db;
                font-weight: 600;
                text-decoration: none;
            }

        .image-side {
            flex: 1;
            margin: 12px 12px 12px 0;
            border-radius: 18px;
            overflow: hidden;
            position: relative;
        }

            .image-side img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: center;
                display: block;
            }

            .image-side::after {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(to bottom, transparent 45%, rgba(0,0,0,0.5) 100%);
                pointer-events: none;
            }

        .img-caption {
            position: absolute;
            bottom: 16px;
            left: 16px;
            right: 16px;
            z-index: 2;
            background: rgba(255,255,255,0.9);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 14px;
            padding: 14px 18px;
        }

            .img-caption p {
                font-size: 12.5px;
                color: #222;
                line-height: 1.6;
                margin-bottom: 11px;
            }

        .cap-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .cap-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #111;
            color: #fff;
            border-radius: 20px;
            padding: 5px 13px;
            font-size: 11px;
            font-weight: 700;
        }

            .cap-badge span {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: #4ade80;
            }

        .cap-site {
            font-size: 11px;
            color: #999;
        }

        @@media (max-width: 700px) {
            .card-shell {
                width: 100%;
                height: auto;
                flex-direction: column;
            }

            .form-side {
                width: 100%;
                padding: 40px 28px;
            }

            .image-side {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="page-bg">
        <div class="card-shell">

            <!-- LEFT -->
            <div class="form-side">
                <div class="brand-row">
                    <div class="brand-dot"></div>
                    <span class="brand-text">ETMS</span>
                </div>

                <h2>Sign in to your account</h2>
                <p class="sub">Enter your credentials to continue</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="err-box">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p>@error.ErrorMessage</p>
                        }
                    </div>
                }

                <form method="post" action="/Account/Login">
                    @Html.AntiForgeryToken()

                    <div class="field">
                        <label>Username</label>
                        <div class="ibox">
                            <i class="fa-solid fa-user"></i>
                            <input type="text" name="Username"
                                   placeholder="Enter your username"
                                   autocomplete="username" required />
                        </div>
                    </div>

                    <div class="field">
                        <label>Password</label>
                        <div class="ibox">
                            <i class="fa-solid fa-lock"></i>
                            <input type="password" name="Password"
                                   placeholder="••••••••" required />
                        </div>
                    </div>

                    <div class="opts">
                        <label class="remember">
                            <input type="checkbox" name="RememberMe" /> Remember me
                        </label>
                        <a href="/Account/ForgotPassword" class="fp">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn-login">Sign in</button>
                </form>

                <p class="footer-note">Having trouble? <a href="mailto:support@@etms.com">Contact support</a></p>
            </div>

            <!-- RIGHT -->
            <div class="image-side">
                <img src="https://2025prodstorageaccount-eqdyc8g8hpccdfez.a02.azurefd.net/ltprod/media/rlojt5xu/hydrocarbon-offshore.webp" alt="ETMS" />
                <div class="img-caption">
                    <p>Manage employee transfers across branches with complete visibility, approvals and audit trails.</p>
                    <div class="cap-row">
                        <div class="cap-badge"><span></span> ETMS Platform</div>
                        <span class="cap-site">etms.company.com</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</body>
</html>
