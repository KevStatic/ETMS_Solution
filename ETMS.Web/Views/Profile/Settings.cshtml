@model ETMS.Application.DTOs.Profile.UserSettingsDto
@{
    ViewData["Title"] = "Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/profile.css" />

<div class="profile-wrapper">
    <div class="settings-page-header">
        <div>
            <h2>Settings</h2>
            <p>Manage your account preferences</p>
        </div>
        <a class="btn btn-outline-primary" asp-controller="Dashboard" asp-action="Index">
            <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-x-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="settings-layout">

        <!-- Sidebar -->
        <div class="settings-sidebar">
            <div class="settings-nav-item active" onclick="showSection('account', this)">
                🔐 Account & Security
            </div>
            <div class="settings-nav-item" onclick="showSection('notifications', this)">
                🔔 Notifications
            </div>
            <div class="settings-nav-item" onclick="showSection('appearance', this)">
                🎨 Appearance
            </div>
        </div>

        <!-- Content -->
        <div class="settings-content">

            <!-- Account & Security -->
            <div id="section-account" class="settings-section">
                <div class="profile-card mb-4">
                    <div class="profile-card-title">🔑 Change Password</div>
                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()
                        <div class="info-row">
                            <label>Current Password</label>
                            <input type="password" class="form-control"
                                   name="CurrentPassword" placeholder="••••••••" required />
                        </div>
                        <div class="info-row">
                            <label>New Password</label>
                            <input type="password" class="form-control"
                                   name="NewPassword" placeholder="••••••••" required />
                        </div>
                        <div class="info-row">
                            <label>Confirm New Password</label>
                            <input type="password" class="form-control"
                                   name="ConfirmNewPassword" placeholder="••••••••" required />
                        </div>
                        <button type="submit" class="btn btn-primary mt-2">
                            Update Password
                        </button>
                    </form>
                </div>

                <div class="profile-card mb-4">
                    <div class="profile-card-title">🛡️ Two-Factor Authentication</div>
                    <form asp-action="SaveSettings" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="UserId" value="@Model.UserId" />
                        <div class="toggle-row">
                            <div>
                                <div class="toggle-label">Enable 2FA</div>
                                <div class="toggle-desc">
                                    Require a one-time code emailed to you each time you sign in.
                                </div>
                            </div>
                            <label class="toggle-switch">
                                @if (Model.TwoFactorEnabled)
                                {
                                    <input type="checkbox" name="TwoFactorEnabled" value="true" checked />
                                }
                                else
                                {
                                    <input type="checkbox" name="TwoFactorEnabled" value="true" />
                                }
                                <span class="toggle-slider"></span>
                                <input type="hidden" name="TwoFactorEnabled" value="false" />
                            </label>
                        </div>
                        <div class="settings-hint">
                            <i class="fas fa-circle-info me-1"></i>
                            When enabled, after entering your password you'll be asked for a 6-digit
                            code sent to your registered email before you're signed in.
                        </div>
                        <div class="text-end mt-3">
                            <button type="submit" class="btn btn-primary">Save</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Notifications -->
            <div id="section-notifications" class="settings-section" style="display:none;">
                <div class="profile-card mb-4">
                    <div class="profile-card-title">🔔 Notification Preferences</div>
                    <form asp-action="SaveSettings" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="UserId" value="@Model.UserId" />

                        <p class="settings-group-label">In-App Alerts</p>
                        <div class="toggle-row">
                            <div>
                                <div class="toggle-label">Enable In-App Alerts</div>
                                <div class="toggle-desc">Master switch for the notification bell. Turning this off mutes every alert below.</div>
                            </div>
                            <label class="toggle-switch">
                                @if (Model.PushInAppAlerts)
                                {
                                    <input type="checkbox" name="PushInAppAlerts" value="true" checked />
                                }
                                else
                                {
                                    <input type="checkbox" name="PushInAppAlerts" value="true" />
                                }
                                <span class="toggle-slider"></span>
                                <input type="hidden" name="PushInAppAlerts" value="false" />
                            </label>
                        </div>

                        <p class="settings-group-label mt-4">Transfer Workflow</p>
                        <div class="toggle-row">
                            <div>
                                <div class="toggle-label">Transfer Status Updates</div>
                                <div class="toggle-desc">When your request moves a stage or is rejected.</div>
                            </div>
                            <label class="toggle-switch">
                                @if (Model.NotifyTransferStatus)
                                {
                                    <input type="checkbox" name="NotifyTransferStatus" value="true" checked />
                                }
                                else
                                {
                                    <input type="checkbox" name="NotifyTransferStatus" value="true" />
                                }
                                <span class="toggle-slider"></span>
                                <input type="hidden" name="NotifyTransferStatus" value="false" />
                            </label>
                        </div>
                        <div class="toggle-row">
                            <div>
                                <div class="toggle-label">Approval Requests</div>
                                <div class="toggle-desc">When a request is waiting for you to approve (for managers, HOD and HR).</div>
                            </div>
                            <label class="toggle-switch">
                                @if (Model.NotifyApprovalRequests)
                                {
                                    <input type="checkbox" name="NotifyApprovalRequests" value="true" checked />
                                }
                                else
                                {
                                    <input type="checkbox" name="NotifyApprovalRequests" value="true" />
                                }
                                <span class="toggle-slider"></span>
                                <input type="hidden" name="NotifyApprovalRequests" value="false" />
                            </label>
                        </div>
                        <div class="toggle-row">
                            <div>
                                <div class="toggle-label">Transfer Letter Ready</div>
                                <div class="toggle-desc">When your transfer is fully approved and the letter is available to download.</div>
                            </div>
                            <label class="toggle-switch">
                                @if (Model.NotifyLetterReady)
                                {
                                    <input type="checkbox" name="NotifyLetterReady" value="true" checked />
                                }
                                else
                                {
                                    <input type="checkbox" name="NotifyLetterReady" value="true" />
                                }
                                <span class="toggle-slider"></span>
                                <input type="hidden" name="NotifyLetterReady" value="false" />
                            </label>
                        </div>

                        <div class="text-end mt-3">
                            <button type="submit" class="btn btn-primary">Save</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Appearance -->
            <div id="section-appearance" class="settings-section" style="display:none;">
                <div class="profile-card mb-4">
                    <div class="profile-card-title">🎨 Appearance & Display</div>
                    <form asp-action="SaveSettings" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="UserId" value="@Model.UserId" />
                        <div class="info-row">
                            <label>Theme</label>
                            <div class="theme-options">
                                <div class="theme-btn @(Model.Theme == "Light" ? "active" : "")"
                                     onclick="setTheme('Light', this)">
                                    ☀️ Light
                                </div>
                                <div class="theme-btn @(Model.Theme == "Dark" ? "active" : "")"
                                     onclick="setTheme('Dark', this)">
                                    🌙 Dark
                                </div>
                                <div class="theme-btn @(Model.Theme == "System" ? "active" : "")"
                                     onclick="setTheme('System', this)">
                                    💻 System
                                </div>
                            </div>
                            <input type="hidden" name="Theme" id="themeInput" value="@Model.Theme" />
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-6">
                                <div class="info-row">
                                    <label>Language</label>
                                    <select class="form-select" name="Language">
                                        @foreach (var lang in new[] { "English", "Hindi", "Marathi" })
                                        {
                                            if (Model.Language == lang)
                                            {
                                                <option value="@lang" selected>@lang</option>
                                            }
                                            else
                                            {
                                                <option value="@lang">@lang</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-row">
                                    <label>Timezone</label>
                                    @{
                                        var tzOptions = new[]
                                        {
                                                                        new { Value = "IST", Label = "IST (UTC+5:30)" },
                                                                        new { Value = "UTC", Label = "UTC" }
                                                                        };
                                    }
                                    <select class="form-select" name="Timezone">
                                        @foreach (var tz in tzOptions)
                                        {
                                            if (Model.Timezone == tz.Value)
                                            {
                                                <option value="@tz.Value" selected>@tz.Label</option>
                                            }
                                            else
                                            {
                                                <option value="@tz.Value">@tz.Label</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="text-end mt-3">
                            <button type="submit" class="btn btn-primary">Save</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showSection(name, el) {
            document.querySelectorAll('.settings-section').forEach(s => s.style.display = 'none');
            document.querySelectorAll('.settings-nav-item').forEach(n => n.classList.remove('active'));
            document.getElementById('section-' + name).style.display = 'block';
            el.classList.add('active');
        }

        function setTheme(val, el) {
            document.querySelectorAll('.theme-btn').forEach(b => b.classList.remove('active'));
            el.classList.add('active');
            document.getElementById('themeInput').value = val;

            document.body.classList.remove('theme-light', 'theme-dark', 'theme-system');
            document.body.classList.add('theme-' + val.toLowerCase());
        }
    </script>
}
