# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored — never commit real secrets.

# 32+ character random key used to encrypt entity ids in URLs.
# Generate one with: openssl rand -hex 32
ENCRYPTION_KEY=

# SMTP credentials for OTP / password-reset emails.
# For Gmail, create an App Password: https://myaccount.google.com/apppasswords
# Double underscore maps to ASP.NET Core config: Smtp__Username -> Smtp:Username
Smtp__Username=
Smtp__Password=
Smtp__FromEmail=
